# Vishwakarma Sync Configuration
# Set to 'gdrive' to fetch from cloud, 'local' for mock_gdrive
PIPELINE_MODE=gdrive

# The long ID of your main Google Drive folder
GDRIVE_FOLDER_ID=your_folder_id_here

# Paste the entire content of your Service Account JSON key as a single line string
# Or just keep it as a multiline string if your shell supports it
GDRIVE_SERVICE_ACCOUNT_KEY='{"type": "service_account", ...}'
